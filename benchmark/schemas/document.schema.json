{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moparse:document:1",
  "type": "object",
  "required": ["schema", "id", "source_path", "sha256", "page_count", "split", "exposure", "leakage_group", "template_family"],
  "properties": {
    "schema": {"const": "moparse-document/1"},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
    "source_path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "page_count": {"type": "integer", "minimum": 1},
    "split": {"enum": ["development", "regression", "holdout"]},
    "exposure": {"enum": ["previously_used", "unseen_at_freeze"]},
    "leakage_group": {"type": "string", "minLength": 1},
    "template_family": {"type": "string", "minLength": 1},
    "derived_from": {"type": "string"}
  }
}
