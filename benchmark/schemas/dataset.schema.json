{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moparse:dataset:1",
  "type": "object",
  "required": ["schema", "id", "version", "documents", "artifacts", "cohorts", "policy", "holdout"],
  "properties": {
    "schema": {"const": "moparse-dataset/1"}, "id": {"type": "string"},
    "version": {"type": "string"}, "documents": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "cohorts": {"type": "array", "items": {"type": "object", "required": ["id", "document_ids", "whole_documents"],
      "properties": {"id": {"type": "string"}, "document_ids": {"type": "array", "items": {"type": "string"}},
        "whole_documents": {"type": "boolean"}}}},
    "policy": {"type": "object"}, "holdout": {"type": "object"}
  }
}
