# Secrets and local overrides
.env
.env.*
!.env.example

# Python
.python-version
.venv/
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.eslintcache
*.tsbuildinfo
static/

# Runtime data and downloaded models
/data/
/models/
*.db
*.db-shm
*.db-wal

# Test output
playwright-report/
test-results/
/tmp/
*.log

/tests/fixtures/progress-pages/

# Private corpus, previews and authored scoring references stay local.
/pdf_sample/
/pdf_sample_extra/*.pdf
/pdf_page_images/
/datasets/authoring/
/datasets/*/inputs/
/datasets/*/references/
/datasets/*/evaluation/

# Keep report documents, summaries and figures in Git; keep raw runs local.
/benchmark/reports/**/artifacts/
/benchmark/reports/**/private/
/benchmark/reports/**/calibration-inputs/
/benchmark/reports/**/visual-review/
/benchmark/reports/**/candidate/
/benchmark/reports/**/scores-*/
/benchmark/reports/**/software/
/benchmark/reports/**/scoring-software/
/benchmark/reference-decisions/evidence/

# Editors / operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
