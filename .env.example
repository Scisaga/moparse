# moparse 0.5.0 example configuration.
# Copy this file to .env. Never commit real API keys or tokens.

# Service
HOST=0.0.0.0
PORT=12303
TZ=Asia/Shanghai
LOG_LEVEL=INFO
JSON_LOGS=0
DATA_DIR=/data
STATIC_DIR=/app/static

# Authentication (empty API_KEY disables public API authentication)
API_KEY=
ADMIN_TOKEN=change-me
CORS_ORIGINS=

# Optional outbound proxy for first-run model downloads. Source URL fetching
# and model API calls intentionally ignore ambient proxies.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,glm-ocr,glm-ocr-sdk,moparse,mosaicparse

# Files and jobs
MAX_UPLOAD_BYTES=209715200
MAX_CONTENT_UNITS=1000
SYNC_MAX_BYTES=20971520
SYNC_MAX_UNITS=10
MAX_QUEUED_JOBS=8
PARSER_WORKERS=1
JOB_RETENTION_HOURS=24
CONTENT_TIMEOUT_SECONDS=900
SSE_HEARTBEAT_SECONDS=15
BACKEND_HEALTH_TTL_SECONDS=15
MAX_VIDEO_SECONDS=1800
VIDEO_MAX_KEYFRAMES=24
VIDEO_MIN_FRAME_SPACING_SECONDS=2
VIDEO_SCENE_THRESHOLD=0.30
VIDEO_MAX_FRAME_PIXELS=33177600
FFMPEG_MAX_CONCURRENCY=1
FFMPEG_THREADS=2
FFMPEG_MAX_ALLOC_BYTES=536870912
FFMPEG_TIMEOUT_SECONDS=300
MAX_ASSETS_PER_CONTENT=200
MAX_ASSET_BYTES=52428800
MAX_EXTRACTED_ASSET_BYTES=419430400
MAX_ASSET_IMAGE_PIXELS=100000000

# Docling (the parser container is deliberately CPU-only)
DOCLING_DEVICE=cpu
# Application-specific name; do not replace it with upstream's conflicting
# DOCLING_ARTIFACTS_PATH unless this directory is already fully prefetched.
DOCLING_LOCAL_ARTIFACTS_PATH=/models/docling
DOCLING_PDF_BACKEND=pypdfium
# TableFormer V1; use accurate mode for the validated PDF configuration.
DOCLING_TABLE_MODE=accurate
DOCLING_FORCE_BACKEND_TEXT=0
DOCLING_MODEL_DOWNLOAD=1
# Disabled by default to avoid a very slow first document on CPU; benchmark before enabling.
DOCLING_COMPILE_MODELS=0
DOCLING_DO_CELL_MATCHING=0
# Intra-model CPU threads per cached converter. More threads have diminishing returns.
DOCLING_NUM_THREADS=4
# Keep 1 as the portable default. On hosts with at least 12 available CPU cores,
# 3 workers can process one native-text PDF in balanced contiguous page chunks.
DOCLING_PAGE_WORKERS=1
DOCLING_PAGE_PARALLEL_MIN_PAGES=4

# Native PDF backend. Docling is a standalone CPU baseline; the evaluated GPU
# combination uses mineru and the optional --profile mineru sidecars.
NATIVE_PARSER_BACKEND=docling
# Optional complete-header verification for MinerU cross-page candidates.
MINERU_HEADER_VERIFIER=off
# Check native-model/source contradictions with the independent Docling parser.
# Requires MINERU_HEADER_VERIFIER=docling. Conflicts retain the original crop/text
# with unknown structure; this check does not certify model correctness.
MINERU_SOURCE_VERIFIER=off
MINERU_NATIVE_BASE_URL=http://mineru-native:8010
MINERU_NATIVE_TIMEOUT_SECONDS=7200
MINERU_VLLM_IMAGE=ghcr.io/scisaga/moparse-mineru-vllm:0.5.0
MINERU_NATIVE_IMAGE=ghcr.io/scisaga/moparse-native-worker:0.5.0
MINERU_GPU_DEVICE_ID=1
MINERU_VLLM_HOST_PORT=12431
MINERU_NATIVE_HOST_PORT=12432
# Bound CPU page/formula batches without dropping pages or formulas.
MINERU_PROCESSING_WINDOW_SIZE=8
MINERU_MALLOC_TRIM=1
MOPARSE_CPU_MFR_BATCH_SIZE=1

# Quality evidence and cross-page continuation
QUALITY_SPARSE_NATIVE_CHARACTERS=40
QUALITY_SPARSE_MAX_IMAGE_COVERAGE=0.05
QUALITY_SPARSE_MAX_INK_RATIO=0.015
QUALITY_NATIVE_MAX_IMAGE_COVERAGE=0.20
QUALITY_SCANNED_MIN_IMAGE_COVERAGE=0.80
QUALITY_SCANNED_MIN_INK_RATIO=0.03
CROSS_PAGE_TABLE_MERGE_ENABLED=1

# Remote GLM-OCR plugin. Disabled so `docker compose up` is CPU-only and standalone.
# For the bundled GPU service, set this to 1 and run with `--profile glm`.
GLM_OCR_ENABLED=0
GLM_OCR_API_URL=http://glm-ocr:8000/v1/chat/completions
GLM_OCR_API_KEY=
GLM_OCR_MODEL=zai-org/GLM-OCR
GLM_OCR_LANG=zh,en
GLM_OCR_MAX_IMAGE_PIXELS=4500000
GLM_OCR_MAX_CONCURRENCY=4
GLM_OCR_MAX_TOKENS=4096
GLM_OCR_TIMEOUT_SECONDS=120
GLM_OCR_MAX_RETRIES=3

# Official GLM-OCR SDK layout and regional OCR evidence.
GLM_SDK_ENABLED=1
GLM_SDK_OFFLINE=0
GLM_SDK_ORIENTATION_ENABLED=1
GLM_SDK_ORIENTATION_MODEL_PATH=/models/huggingface/PP-LCNet_x1_0_doc_ori_safetensors
GLM_SDK_URL=http://glm-ocr-sdk:5002/glmocr/parse
GLM_SDK_TIMEOUT_SECONDS=120
# 200 DPI = 200 / 72 PDF points, matching the selected SDK experiment.
GLM_SDK_RENDER_SCALE=2.7777777777777777
GLM_SDK_MAX_IMAGE_PIXELS=8000000
GLM_SDK_MAX_CONCURRENCY=1
GLM_SDK_MAX_RETRIES=1

# URL download / SSRF policy
ALLOW_SOURCE_URLS=1
ALLOW_PRIVATE_SOURCE_URLS=0
SOURCE_URL_MAX_REDIRECTS=3
SOURCE_URL_TIMEOUT_SECONDS=30
SOURCE_URL_USER_AGENT=moparse/0.5.0

# MCP
MCP_ENABLED=1
MCP_MAX_INLINE_BYTES=2097152
MCP_MAX_RESULT_CHARS=200000
# DNS-rebinding protection. Add each public host[:port] and trusted Origin explicitly.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],moparse,mosaicparse
MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Docker Compose image and GPU options
MOPARSE_IMAGE=ghcr.io/scisaga/moparse:0.5.0
GLM_VLLM_IMAGE=vllm/vllm-openai:v0.19.1
GLM_SDK_IMAGE=docling-glm-ocr-sdk:0.1.5
GLM_GPU_DEVICE_ID=1
GLM_OCR_BIND_ADDRESS=127.0.0.1
GLM_OCR_HOST_PORT=8001
GLM_GPU_MEMORY_UTILIZATION=0.40
GLM_MAX_MODEL_LEN=16384
# RTX 2080 Ti/Turing has no BF16 support; use FP16 unless verified otherwise.
GLM_DTYPE=half
HF_TOKEN=
