+def _cpu_batch_limit() -> int:
+    """Allow a deployment to lower CPU microbatches without dropping formulas."""
+    raw = os.getenv("MOPARSE_CPU_MFR_BATCH_SIZE")
+    if raw is None:
+        return CPU_BATCH_SIZE
+    try:
+        limit = int(raw)
+    except ValueError as exc:
+        raise ValueError("MOPARSE_CPU_MFR_BATCH_SIZE must be an integer from 1 to 8") from exc
+    if not 1 <= limit <= CPU_BATCH_SIZE:
+        raise ValueError("MOPARSE_CPU_MFR_BATCH_SIZE must be an integer from 1 to 8")
+    return limit
 
