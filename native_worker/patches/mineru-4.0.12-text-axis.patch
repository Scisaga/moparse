+        # Rotation of an axis-aligned enclosing box enlarges its bounds. Keep
+        # the original source-region containment before testing its text axis.
+        original_center_x = (char_bbox[0] + char_bbox[2]) / 2
+        original_center_y = (char_bbox[1] + char_bbox[3]) / 2
+        if not (span_bbox[0] < original_center_x < span_bbox[2]
+                and span_bbox[1] < original_center_y < span_bbox[3]):
+            return False
+    char_bbox = _project_text_axis_bbox(char_bbox, writing_angle)
+    span_bbox = _project_text_axis_bbox(span_bbox, writing_angle)
     char_center_x = (char_bbox[0] + char_bbox[2]) / 2
