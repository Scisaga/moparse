+def _project_text_axis_bbox(bbox: BBox, writing_angle: float) -> BBox:
+    """Express geometry in the glyph's writing frame, not page x/y axes.
+
+    Project both rectangles identically. Source angles are radians; this
+    handles all directions, including 90/180/270-degree PDF text, without
+    deriving direction from text or the heights of unrelated page spans.
+    """
+    if writing_angle == 0.0:
+        return bbox
+    cosine, sine = math.cos(writing_angle), math.sin(writing_angle)
+    corners = [(x * cosine + y * sine, -x * sine + y * cosine)
+               for x in (bbox[0], bbox[2]) for y in (bbox[1], bbox[3])]
+    return (min(p[0] for p in corners), min(p[1] for p in corners),
+            max(p[0] for p in corners), max(p[1] for p in corners))
+
